[TEMPLATE]
# Copy to `.env`. Vite only exposes variables prefixed with VITE_ to the browser.

# Backend URL. Defaults to http://localhost:5000 when unset.
VITE_API_URL=http://localhost:5000

# Clerk publishable key — same value as backend CLERK_PUBLISHABLE_KEY.
# Safe to ship to the browser (the secret key is not).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
