[TEMPLATE]
# ─────────────────────────────────────────────────────────────
#  MAD Researcher — backend configuration
#  Copy this file to `.env` and fill in your keys:  cp .env.example .env
#  The server refuses to start until every required key is present.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ── Auth (Clerk) ─────────────────────────────────────────────
# Clerk Dashboard → API keys → Quick Copy. Both are required.
# CLERK_SECRET_KEY is server-only — never expose it to the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# ── Storage (MongoDB Atlas) ──────────────────────────────────
# The only storage driver. Reports are saved to this cluster and are private
# to the signed-in user who created them.
# Atlas → Connect → Drivers → copy the connection string, then swap in the
# database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/deep-research?retryWrites=true&w=majority

# ── LLM (bring your own provider) ────────────────────────────
# Any endpoint that speaks the OpenAI /v1/chat/completions protocol works.
# You do NOT need an OpenAI account. Set the base URL to your provider and
# use any model name from that provider's catalogue.
LLM_API_KEY=your-provider-key
# e.g. https://api.groq.com/openai/v1  ·  https://openrouter.ai/api/v1
LLM_BASE_URL=
# Model names are passed straight through — use whatever your provider calls them.
LLM_MODEL=gpt-4o-mini
# Reasoning-heavy steps (planner + writer + critic). Falls back to LLM_MODEL if unset.
LLM_MODEL_SMART=gpt-4o
# Set false for providers that reject response_format=json_object (some local
# models). The prompts still request JSON and the parser recovers it.
LLM_JSON_MODE=true

# ── Stall protection ─────────────────────────────────────────
# A model or search call that never answers must not hold the run open. Without
# these, the OpenAI SDK waits up to 10 minutes per attempt and retries twice, so
# a single bad model name looks like a hang for half an hour.

# Hard ceiling on one model request, in ms.
LLM_TIMEOUT_MS=120000
# Retries after a timeout or a transient provider error. Two is the SDK's own
# default and rides out a flaky 5xx; worst case is (retries + 1) × LLM_TIMEOUT_MS.
LLM_MAX_RETRIES=2
# A *streamed* answer that sends no token for this long is cut off as stalled.
# The SDK clears its own timeout once response headers arrive, so a stream that
# opens and then goes quiet is otherwise unbounded. Raise this for a slow
# reasoning model that thinks for a long time before writing.
LLM_STREAM_IDLE_TIMEOUT_MS=60000
# NOTE: a thinking model that spends its whole budget on reasoning returns no
# content at all (finish_reason "length", 0 completion tokens). That is reported
# as an empty-response error naming the model rather than being silently used.

# NOTE: OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL / OPENAI_MODEL_SMART /
# OPENAI_JSON_MODE are still honoured as fallbacks, but the LLM_* names above win.

# ── Provider examples (uncomment one) ────────────────────────
# Groq          LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=llama-3.3-70b-versatile
#               LLM_MODEL_SMART=llama-3.3-70b-versatile
# OpenRouter    LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=openai/gpt-4o-mini
#               LLM_MODEL_SMART=anthropic/claude-3.5-sonnet
# Together      LLM_BASE_URL=https://api.together.xyz/v1
#               LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Google Gemini LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#               LLM_MODEL=gemini-3.5-flash-lite
#               LLM_MODEL_SMART=gemini-3.5-flash-lite
# Ollama (local) LLM_BASE_URL=http://localhost:11434/v1
#                LLM_API_KEY=ollama
#                LLM_MODEL=llama3.1
#                LLM_MODEL_SMART=llama3.1
#                LLM_JSON_MODE=false

# ── Web search (Tavily) ──────────────────────────────────────
# Powers both research tools: web search and full-page extraction.
TAVILY_API_KEY=tvly-your-key-here
# Max results fetched per search (1–12)
TAVILY_MAX_RESULTS=6

# ── Research behaviour ───────────────────────────────────────
# How many sub-questions the planner may create (1–8)
MAX_SUBQUESTIONS=6
# "quick" = basic search depth, "deep" = advanced search + advanced extraction
RESEARCH_DEPTH=deep
# Sub-questions researched in parallel (1–6). The sub-questions are independent,
# so this is the main wall-clock lever on a run.
RESEARCH_CONCURRENCY=3
# Absolute ceiling on one run, in ms. When it expires the run is stopped and the
# client is told why, so no run can stay open indefinitely.
RUN_TIMEOUT_MS=900000

# ── Depth & integrity ────────────────────────────────────────
# Extra gap-filling search rounds per sub-question when coverage is low (0–3).
# 0 disables gap filling entirely.
RESEARCH_MAX_ROUNDS=2
# The researcher's self-reported coverage (%) below which a gap round fires (0–100)
COVERAGE_FLOOR=60
# Follow-up queries the researcher may propose per gap round (0–4)
MAX_FOLLOWUP_QUERIES=2
# Fetch full page text (not just search snippets) for the strongest sources
DEEP_FETCH=true
# How many pages per sub-question to read in full (0–8)
DEEP_FETCH_SOURCES=3
# Run the critic → revisor pass: audit the draft against its sources, then fix it
RESEARCH_CRITIQUE=true
# Cited sources the critic reads as full page text rather than a search snippet
# (0–16, 0 = snippets only). The critic is what catches miscitation and
# overreach, so it reviews the same evidence the researcher extracted from.
CRITIC_FULL_TEXT_SOURCES=8
